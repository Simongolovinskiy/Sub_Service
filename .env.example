POSTGRES_DB=sub_service
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_PORT=8087
REDIS_PORT=6379
DATABASE_CONNECTION_STRING=postgresql://postgres:postgres@localhost:8087/sub_service
LOG_LEVEL=INFO
APP_PORT=8000
APP_WORKERS=4
VPN_PANEL_BASE_URL=http://127.0.0.1:8080
VPN_PANEL_TOKEN=
VPN_INTERNAL_SQUADS=[]
