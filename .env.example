VPN_OPERATION_TIMEOUT=2
VPN_RETRY_INITIAL=0.2
VPN_RETRY_MAX=300
VPN_POLLING_SECONDS=300
VPN_CACHE_TIMEOUT=0.2
VPN_NEGATIVE_CACHE_TTL=30
VPN_IDEMPOTENCY_TTL=86400
